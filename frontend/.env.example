# Build-time settings. Only VITE_* variables are exposed to the browser bundle.
VITE_APP_NAME=Calculator
# Origin of the API, e.g. https://api.example.com. Empty means same origin; the code
# appends /api/v1 either way.
VITE_API_BASE_URL=
# Client-side fetch timeout; a request without a response by then shows the network message.
VITE_API_TIMEOUT_MS=10000

# The dev and preview servers proxy /api to http://localhost:8080. To use another address,
# set API_PROXY_TARGET in the shell; vite.config.ts reads it from there, not from this file:
#   API_PROXY_TARGET=http://localhost:9090 npm run dev
